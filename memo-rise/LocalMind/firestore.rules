rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// The client-side SyncPolicy is a convenience, not a guarantee — anyone can repackage
// your APK. These rules are the actual enforcement, so they mirror the policy:
// a document shape that isn't in the allow-list simply cannot be written.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {

      // The profile doc: persona and settings only.
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.keys().hasOnly(
                        ['persona', 'groundingEnabled', 'updatedAt'])
                   && request.resource.data.persona is string
                   && request.resource.data.persona.size() < 4000;

      // Durable facts. Categories the app treats as sensitive are rejected here too,
      // so a tampered client still can't park health or credential data on the server.
      match /memories/{memoryId} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid)
                     && request.resource.data.keys().hasOnly(
                          ['text', 'category', 'confidence', 'createdAt', 'updatedAt'])
                     && request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 140
                     && request.resource.data.confidence >= 0.65
                     && request.resource.data.category in [
                          'identity', 'preference', 'goal', 'relationship', 'constraint'
                        ];
      }

      // Messages the user pinned. One document per pin, written individually.
      // There is no collection here that can hold a whole conversation.
      match /pinned/{messageId} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid)
                     && request.resource.data.keys().hasOnly(
                          ['text', 'role', 'createdAt', 'sources', 'pinnedAt'])
                     && request.resource.data.text is string
                     && request.resource.data.text.size() <= 8000
                     && request.resource.data.role in ['USER', 'MODEL'];
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
